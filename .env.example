# Copie para .env e ajuste. Nunca envie o .env para o GitHub.

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Sem DATABASE_URL o projeto usa SQLite (db.sqlite3) para desenvolvimento rápido.
# Com o docker-compose, o PostgreSQL fica em:
# DATABASE_URL=postgres://popruajud:popruajud@localhost:5432/popruajud

# Chave AES-256 das fotos e modelos faciais (RNF-08): 32 bytes em base64.
# Gere com: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CHAVE_DADOS_FACIAIS=

# Limiar de similaridade do reconhecimento facial (RNF-09). 0.363 é o valor
# indicado pelo OpenCV para o SFace com distância de cosseno.
FACE_LIMIAR=0.363
